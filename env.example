# Logging configuration
# Per-handler log levels (DEBUG, INFO, WARNING, ERROR, CRITICAL). The console
# handler mirrors what you see in the terminal; the file handler writes to a
# rotating log file. The two levels can differ.
LOG_LEVEL_CONSOLE=WARNING
LOG_LEVEL_FILE=INFO
# Enable/disable the rotating file handler (console logging always stays on).
LOG_FILE_ENABLED=True
# Path to the log file (relative paths resolve against the project root).
LOG_FILE_PATH=logs/bimfabrikhh.log
# Time-based rotation interval (midnight, H, D, S, ...) and number of rotated
# backups to keep.
LOG_FILE_WHEN=midnight
LOG_FILE_BACKUP_COUNT=14
