# Ignore IDE settings of PyCharm/VSCode
.idea/
.vscode/

*.ifc
*.log
*.dwg

# Keep logs/ in the repo; ignore files written there (including rotated logs)
logs/*
!logs/README.md
.env
poetry.lock

# Ignore Python cache files and folders
**/__pycache__/
*.py[cod]

# Ignore local folders
__local_dev
__output_dev
__samples
output/errors
examples_local/

/local_workflows/
/examples/assets/data_sachsen/
/examples/assets/data_schleswigHolstein/
